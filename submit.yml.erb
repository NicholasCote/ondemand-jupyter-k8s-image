<%-
  configmap_filename = "ondemand_config.py"
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new

  # Validate the user-supplied image reference before it touches any YAML.
  # ood_core's pod.yml.erb emits the main container's image field unquoted,
  # so a value containing ": ", "#", or a newline can restructure the
  # generated Pod manifest. Rather than out-escape a template we don't
  # control, reject anything that isn't a plain image reference at the door.
  image_ref = custom_image.to_s.strip
  image_ref_pattern = /\A[A-Za-z0-9][A-Za-z0-9._\-\/:@]{0,254}\z/
  unless image_ref.match?(image_ref_pattern)
    raise "Invalid container image reference: #{image_ref.inspect}. " \
          "Expected something like registry.example.com/namespace/image:tag " \
          "(letters, digits, '.', '_', '-', '/', ':', '@' only; no spaces or quotes)."
  end
-%>
---
script:
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    container:
      name: "jupyter"
      image: "<%= image_ref %>"
      # Launched through /ood/launch.sh (defined in the configmap below) rather
      # than by naming the entrypoint directly, because this app runs images we
      # do not control and there are two incompatible conventions in the wild:
      #
      #   jupyter/docker-stacks  /usr/local/bin/start.sh  /opt/conda/bin/jupyter
      #   repo2docker & cirrus   /srv/start               /srv/conda/bin/jupyter
      #
      # Naming either one directly fails on the other with a bare
      # "executable file not found: No such file or directory" at container
      # create -- no hint about which path was missing, in a message the user
      # sees before the session ever starts. launch.sh probes for both.
      #
      # Every token here is space-free on purpose: ood_core renders this into the
      # pod's `command` array, and a quoted `sh -c '...'` script would not survive
      # if it splits on whitespace. Invoking via /bin/sh also avoids needing the
      # configmap file to be executable, which projected volumes do not guarantee.
      command: "/bin/sh /ood/launch.sh lab --config=/ood/ondemand_config.py --ServerApp.port=8080 --ServerApp.ip=0.0.0.0"
      restart_policy: "OnFailure"
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
        JUPYTER_RUNTIME_DIR: "/tmp/jupyter/runtime"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
    configmap:
      files:
        - filename: "<%= configmap_filename %>"
          data: |
            c.ServerApp.port = 8080
            c.ServerApp.ip = '0.0.0.0'
            c.ServerApp.disable_check_xsrf = True
            c.ServerApp.allow_origin = '*'
            c.Application.log_level = 'DEBUG'
          mount_path: "/ood"
        # Resolve the image's layout at runtime, inside the container, which is
        # the only place that knows what the image actually contains. ERB cannot
        # do this: it renders on the OnDemand host at submit time, before the
        # image has been pulled anywhere.
        #
        # Deliberately plain /bin/sh -- an image may not ship bash.
        - filename: "launch.sh"
          data: |
            #!/bin/sh
            # Find the startup wrapper. It is what drops privileges to NB_UID and
            # sets the session up, so prefer it over exec'ing jupyter directly.
            for w in /usr/local/bin/start.sh /srv/start; do
              [ -x "$w" ] && { WRAP="$w"; break; }
            done

            # Find jupyter. The same split applies here, and getting the wrapper
            # right while hardcoding the wrong conda prefix just moves the error.
            for j in /opt/conda/bin/jupyter /srv/conda/bin/jupyter; do
              [ -x "$j" ] && { JUP="$j"; break; }
            done
            # Last resort: whatever is on PATH. Covers layouts we have not seen.
            [ -n "${JUP:-}" ] || JUP="$(command -v jupyter 2>/dev/null)"

            if [ -z "${JUP:-}" ]; then
              echo "launch.sh: no jupyter found in this image." >&2
              echo "  looked in: /opt/conda/bin, /srv/conda/bin, and \$PATH" >&2
              echo "  PATH=$PATH" >&2
              exit 127
            fi

            # Say what was chosen. When a session misbehaves, the first question
            # is which binaries it actually ran, and kubectl logs should answer it
            # without anyone having to exec into the pod.
            echo "launch.sh: wrapper=${WRAP:-<none, exec jupyter directly>} jupyter=${JUP}"

            [ -n "${WRAP:-}" ] && exec "$WRAP" "$JUP" "$@"
            exec "$JUP" "$@"
          mount_path: "/ood"
    init_containers:
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
          - "user-<%= user.name %>"
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; source /bin/create_salt_and_sha1; Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.PasswordIdentityProvider.hashed_password=${Q}sha1:${SALT}:${PASSWORD_SHA1}${Q} <%= configmap_filename %>"
      - name: "add-hostport-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "PORT_CFG=$(kubectl get services $(hostname)-service -o jsonpath='{.spec.ports[0].nodePort}'); HOST_CFG=$(kubectl get pods $(hostname) -o jsonpath='{.spec.nodeName}'); Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.ServerApp.base_url=${Q}/node/${HOST_CFG}/${PORT_CFG}/${Q} <%= configmap_filename %>"