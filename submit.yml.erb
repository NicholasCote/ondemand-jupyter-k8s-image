<%-
  configmap_filename = "ondemand_config.py"
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new
-%>
---
script:
  wall_time: "<%= wall_time.to_i * 3600 %>"
  native:
    container:
      name: "jupyter"
      image: "<%= image_ref %>"
      command: "/usr/local/bin/start.sh /opt/conda/bin/jupyter lab --config=/ood/ondemand_config.py --ServerApp.port=8080 --ServerApp.ip=0.0.0.0"
      restart_policy: "OnFailure"
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
        JUPYTER_RUNTIME_DIR: "/tmp/jupyter/runtime"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
    configmap:
      files:
        - filename: "<%= configmap_filename %>"
          data: |
            c.ServerApp.port = 8080
            c.ServerApp.ip = '0.0.0.0'
            c.ServerApp.disable_check_xsrf = True
            c.ServerApp.allow_origin = '*'
            c.Application.log_level = 'DEBUG'
          mount_path: "/ood"
    init_containers:
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
          - "user-<%= user.name %>"
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; source /bin/create_salt_and_sha1; Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.PasswordIdentityProvider.hashed_password=${Q}sha1:${SALT}:${PASSWORD_SHA1}${Q} <%= configmap_filename %>"
      - name: "add-hostport-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "PORT_CFG=$(kubectl get services $(hostname)-service -o jsonpath='{.spec.ports[0].nodePort}'); HOST_CFG=$(kubectl get pods $(hostname) -o jsonpath='{.spec.nodeName}'); Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.ServerApp.base_url=${Q}/node/${HOST_CFG}/${PORT_CFG}/${Q} <%= configmap_filename %>"