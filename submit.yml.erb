<%-
  configmap_filename = "ondemand_config.py"
  utility_img = "docker.io/ohiosupercomputer/ood-k8s-utils:latest"
  user = OodSupport::User.new

  # Validate the user-supplied image reference before it touches any YAML.
  # ood_core's pod.yml.erb emits the main container's image field unquoted,
  # so a value containing ": ", "#", or a newline can restructure the
  # generated Pod manifest. Rather than out-escape a template we don't
  # control, reject anything that isn't a plain image reference at the door.
  image_ref = custom_image.to_s.strip
  image_ref_pattern = /\A[A-Za-z0-9][A-Za-z0-9._\-\/:@]{0,254}\z/
  unless image_ref.match?(image_ref_pattern)
    raise "Invalid container image reference: #{image_ref.inspect}. " \
          "Expected something like registry.example.com/namespace/image:tag " \
          "(letters, digits, '.', '_', '-', '/', ':', '@' only; no spaces or quotes)."
  end
-%>
---
script:
  wall_time: "<%= wall_time.to_i * 3600 %>"
  # Requested only when the user asked for at least one. ood_core renders this
  # into the pod's resource limits AND requests as
  #
  #   nvidia.com/gpu: <n>
  #
  # (the key comes from native.gpu_type, which defaults to nvidia.com/gpu), and
  # it guards the field with `unless script.gpus_per_node.nil?` -- a nil check,
  # not a zero check. Emitting 0 would therefore still put the resource key in
  # the spec; omitting the line keeps a CPU-only session's pod byte-identical
  # to what this app produced before GPUs were an option.
  #
  # to_i is load-bearing, not decoration: this value is interpolated unquoted,
  # so anything that is not a plain integer could restructure the YAML the same
  # way an unvalidated image reference could.
<%- if gpus.to_i > 0 -%>
  gpus_per_node: <%= gpus.to_i %>
<%- end -%>
  native:
    container:
      name: "jupyter"
      image: "<%= image_ref %>"
      # Launched through /ood-launch/launch.sh (defined in the configmap below) rather
      # than by naming the entrypoint directly, because this app runs images we
      # do not control and there are two incompatible conventions in the wild:
      #
      #   jupyter/docker-stacks  /usr/local/bin/start.sh  /opt/conda/bin/jupyter
      #   repo2docker & cirrus   /srv/start               /srv/conda/bin/jupyter
      #
      # Naming either one directly fails on the other with a bare
      # "executable file not found: No such file or directory" at container
      # create -- no hint about which path was missing, in a message the user
      # sees before the session ever starts. launch.sh probes for both.
      #
      # Every token here is space-free on purpose: ood_core renders this into the
      # pod's `command` array, and a quoted `sh -c '...'` script would not survive
      # if it splits on whitespace. Invoking via /bin/sh also avoids needing the
      # configmap file to be executable, which projected volumes do not guarantee.
      #
      # /ood-launch, not /ood: ood_core emits one volumeMount per configmap file,
      # so two files sharing a mount_path produce duplicate mountPaths and the
      # API server rejects the pod outright --
      #   spec.containers[0].volumeMounts[1].mountPath: "/ood": must be unique
      command: "/bin/sh /ood-launch/launch.sh lab --config=/ood/ondemand_config.py --ServerApp.port=8080 --ServerApp.ip=0.0.0.0"
      restart_policy: "OnFailure"
      # Start in the user's NFS home, not wherever the image's WORKDIR points.
      #
      # docker-stacks bakes WORKDIR /home/jovyan into the image, and its start.sh
      # only cd's to $HOME on the root path -- we run as the user's real UID, so
      # that path never executes. The result is a session whose cwd is the
      # image's throwaway /home/jovyan: Jupyter's root_dir defaults to cwd, so
      # the file browser and every terminal open on an empty container-local
      # directory and anything saved there dies with the pod.
      working_dir: "<%= user.home %>"
      env:
        NB_UID: "<%= user.uid %>"
        NB_USER: "<%= user.name %>"
        NB_GID: "<%= user.group.id %>"
        HOME: "<%= user.home %>"
        JUPYTER_RUNTIME_DIR: "/tmp/jupyter/runtime"
      port: 8080
      cpu: "<%= cpu %>"
      memory: "<%= memory %>Gi"
    mounts:
      - type: nfs
        name: home
        host: "gladenfs.hpc.ucar.edu"
        path: "/gpfs/u/home/<%= user.name %>"
        destination_path: "<%= user.home %>"
    configmap:
      files:
        - filename: "<%= configmap_filename %>"
          data: |
            c.ServerApp.port = 8080
            c.ServerApp.ip = '0.0.0.0'
            c.ServerApp.disable_check_xsrf = True
            c.ServerApp.allow_origin = '*'
            c.Application.log_level = 'DEBUG'
          mount_path: "/ood"
        # Resolve the image's layout at runtime, inside the container, which is
        # the only place that knows what the image actually contains. ERB cannot
        # do this: it renders on the OnDemand host at submit time, before the
        # image has been pulled anywhere.
        #
        # Deliberately plain /bin/sh -- an image may not ship bash.
        #
        # Mounted at its own path. Each entry here becomes a separate volumeMount,
        # and k8s requires mountPaths to be unique, so this cannot share /ood with
        # ondemand_config.py.
        - filename: "launch.sh"
          data: |
            #!/bin/sh
            # Find the startup wrapper. It is what drops privileges to NB_UID and
            # sets the session up, so prefer it over exec'ing jupyter directly.
            for w in /usr/local/bin/start.sh /srv/start; do
              [ -x "$w" ] && { WRAP="$w"; break; }
            done

            # Find jupyter. The same split applies here, and getting the wrapper
            # right while hardcoding the wrong conda prefix just moves the error.
            for j in /opt/conda/bin/jupyter /srv/conda/bin/jupyter; do
              [ -x "$j" ] && { JUP="$j"; break; }
            done
            # Last resort: whatever is on PATH. Covers layouts we have not seen.
            [ -n "${JUP:-}" ] || JUP="$(command -v jupyter 2>/dev/null)"

            if [ -z "${JUP:-}" ]; then
              echo "launch.sh: no jupyter found in this image." >&2
              echo "  looked in: /opt/conda/bin, /srv/conda/bin, and \$PATH" >&2
              echo "  PATH=$PATH" >&2
              exit 127
            fi

            # Say what was chosen. When a session misbehaves, the first question
            # is which binaries it actually ran, and kubectl logs should answer it
            # without anyone having to exec into the pod.
            echo "launch.sh: wrapper=${WRAP:-<none, exec jupyter directly>} jupyter=${JUP}"

            [ -n "${WRAP:-}" ] && exec "$WRAP" "$JUP" "$@"
            exec "$JUP" "$@"
          mount_path: "/ood-launch"
        # Make `conda activate` work in session terminals.
        #
        # Without this the user gets
        #
        #   CondaError: Run 'conda init' before 'conda activate'
        #
        # and running `conda init` does not help -- it reports success, changes
        # nothing that matters, and the next terminal fails identically. Two
        # things combine to cause that:
        #
        #   1. jupyter_server_terminals appends "-l" to the shell whenever the
        #      server's stdout is not a tty, which in a pod it never is. So
        #      terminals are LOGIN shells, and a login shell reads /etc/profile
        #      and ~/.bash_profile -- never ~/.bashrc, which is the only file
        #      `conda init` writes to.
        #   2. Docker Stacks images put their conda hook in /home/jovyan/.bashrc
        #      and ship no /etc/profile.d entry at all. Since HOME is the user's
        #      NFS home, that file is not read either.
        #
        # /etc/profile.d is the one hook both distro families source for login
        # shells, so that is where this goes. Mounting here is additive -- a
        # filename no image ships, in a directory that already exists -- so
        # unlike /etc/passwd it hides nothing.
        #
        # The conda prefix is probed rather than assumed, for the same reason
        # launch.sh probes: /opt/conda, /srv/conda and /opt/ncar/conda are all
        # in use across the images people actually launch here.
        #
        # Guarded on BASH_VERSION because `conda shell.bash hook` emits bash
        # syntax and /etc/profile.d is also sourced by dash. Every failure is
        # swallowed: a login shell that cannot find conda must still be a
        # working shell.
        - filename: "conda_profile.sh"
          data: |
            if [ -n "${BASH_VERSION:-}" ]; then
              __ood_conda=""
              for __ood_c in /opt/conda/bin/conda /srv/conda/bin/conda; do
                if [ -x "${__ood_c}" ]; then __ood_conda="${__ood_c}"; break; fi
              done
              if [ -z "${__ood_conda}" ]; then __ood_conda="$(command -v conda 2>/dev/null)"; fi
              if [ -n "${__ood_conda}" ]; then
                __ood_hook="$("${__ood_conda}" shell.bash hook 2>/dev/null)" && eval "${__ood_hook}"
              fi
              unset __ood_conda __ood_hook __ood_c
            fi
          # zz- so this runs after anything the image installs here. The
          # /srv/start images already set conda up themselves and re-evaluating
          # the hook after them is harmless -- verified, not assumed.
          mount_path: "/etc/profile.d/zz-ood-conda.sh"
          sub_path: "conda_profile.sh"
        # Give the UID we run as a name.
        #
        # The pod's securityContext is runAsUser: <the user's real UID>, but the
        # image's /etc/passwd only knows the UID it was built with (1000/jovyan).
        # Every getpwuid() lookup then fails, which surfaces as the
        # "I have no name!" bash prompt and, less visibly, as git and conda
        # tripping over a missing username, home, and shell.
        #
        # docker-stacks' start.sh tries to patch /etc/passwd itself, but only
        # when the file is writable, which assumes GID 0. We run as the user's
        # real GID, so it logs "unable to fix missing /etc/passwd entry" and
        # carries on nameless. Supplying the file needs no cooperation from the
        # image and works on the /srv/start images too, which never attempt it.
        #
        # We ADD to the image's accounts, we do not replace them. An earlier
        # version of this file listed only root, the user, and nobody, which
        # crashlooped every docker-stacks image: start.sh runs under `set -e`
        # and line 193 is
        #
        #   JOVYAN_UID="$(id -u jovyan 2>/dev/null)"
        #
        # `id` exits 1 when the user does not exist, an assignment inherits the
        # status of its command substitution, and the script died right there --
        # after the start-notebook.d hooks, before exec'ing jupyter, with no
        # error message. jovyan (1000:100) is the default user for both
        # docker-stacks and repo2docker, so it stays, as do the system accounts.
        #
        # Order matters: the real user is listed BEFORE jovyan so that if a
        # user's UID is itself 1000, getpwuid(1000) resolves to them while
        # getpwnam("jovyan") still succeeds for start.sh.
        #
        # sub_path is what makes this safe: without it the configmap volume
        # would mount over all of /etc and take the image's resolv.conf and ssl
        # certs with it. With it, k8s projects this one key over that one file.
        #
        # Shell is hardcoded to /bin/bash rather than read from the user's HPC
        # passwd entry: a login shell of /bin/tcsh is common here and almost
        # never present in a Jupyter image, and a shell that does not exist
        # breaks terminals as thoroughly as no passwd entry at all.
        # Only the entries that are actually needed, and nothing distro-specific.
        # An earlier version padded these files with daemon/bin/sys/nobody taken
        # from a Debian image, which is wrong on a RHEL-based one: those two
        # families disagree outright (Debian daemon=1 bin=2, RHEL bin=1
        # daemon=2), so the padding mislabelled real GIDs. A missing name is a
        # cosmetic annoyance; a wrong name is a lie that `ls -l` repeats.
        - filename: "passwd"
          data: |
            root:x:0:0:root:/root:/bin/bash
            <%= user.name %>:x:<%= user.uid %>:<%= user.group.id %>:<%= user.gecos %>:<%= user.home %>:/bin/bash
            jovyan:x:1000:100:default container user:/home/jovyan:/bin/bash
          mount_path: "/etc/passwd"
          sub_path: "passwd"
        # Groups, seeded from this host's own group database.
        #
        # A GID with no name is not merely untidy: `groups` prints
        #
        #   groups: cannot find name for group ID 39
        #
        # to the terminal, and an end user has no way to tell that from a real
        # problem. The case that shows up in practice is a GPU session, where
        # the runtime attaches the group owning /dev/nvidia* so the container
        # can open the device -- GID 39 here. That group is doing its job; it
        # is what lets nvidia-smi see the card. It just had no name, because
        # mounting this file at all hides the names the image shipped.
        #
        # The names cannot be hardcoded -- that is what mislabelled GIDs 1 and
        # 2 on RHEL-based images -- and they cannot be read from the image,
        # which is not pulled anywhere at submit time. But they do not need to
        # be either: the supplementary GIDs a container ends up with are
        # assigned by the node, not the image, so the node's numbering is the
        # one that matters, and this host shares it. So copy the local system
        # groups verbatim rather than guessing at any of them.
        #
        # Only GID < 1000, i.e. the system range, which is where injected
        # device groups live. Everything above it is user and LDAP territory:
        # unbounded, irrelevant here, and not ours to publish into a container.
        # Reading the file directly rather than via Etc.group is what keeps
        # that promise -- Etc.group walks all of NSS, LDAP included.
        - filename: "group"
          data: |
            root:x:0:
            <%= user.group.name %>:x:<%= user.group.id %>:<%= user.name %>
<%-
  # Never let a group lookup break submission; an unnamed GID is a blemish,
  # a failed launch is not.
  seen_gids  = [0, user.group.id]
  seen_names = ["root", user.group.name]
  host_groups = begin
                  File.readlines("/etc/group")
                rescue StandardError
                  []
                end
  host_groups.each do |line|
    name, _passwd, gid, _members = line.chomp.split(":", 4)
    next if name.nil? || gid.nil? || gid !~ /\A\d+\z/
    gid = gid.to_i
    next if gid >= 1000
    next if seen_gids.include?(gid) || seen_names.include?(name)
    seen_gids << gid
    seen_names << name
-%>
            <%= name %>:x:<%= gid %>:
<%- end -%>
<%- unless seen_gids.include?(100) || seen_names.include?("users") -%>
            users:x:100:jovyan
<%- end -%>
          mount_path: "/etc/group"
          sub_path: "group"
    init_containers:
      - name: "init-secret"
        image: "<%= utility_img %>"
        command:
          - "/bin/save_passwd_as_secret"
          - "user-<%= user.name %>"
      # Write the session password under every trait name Jupyter has used for
      # it, for the same reason launch.sh probes for two directory layouts: we
      # do not control the image, and the correct name depends on its vintage.
      #
      #   c.PasswordIdentityProvider.hashed_password  jupyter_server >= 2.0
      #   c.ServerApp.password                        jupyter_server 1.x
      #   c.NotebookApp.password                      classic notebook
      #
      # Setting only the first one silently does nothing on an older image:
      # traitlets warns about unknown *options* on a class it knows, but an
      # entire unknown class section is ignored without comment. The server
      # then keeps token auth, the Connect button's POST gets a 401, and the
      # user lands on "Token authentication is enabled" with no clue why.
      # Confirmed on an image pinned to jupyter_server 1.21.0 / notebook 6.5.1.
      #
      # The extra lines are harmless where they do not apply -- on 2.x they
      # cost one "ServerApp.password config is deprecated in 2.0" warning, and
      # the value is identical either way, so nothing can disagree.
      #
      # '\\\\047' is not over-escaped: this string is parsed as YAML twice
      # before bash sees it, once by OnDemand reading this file and once by
      # kubectl reading the pod spec ood_core renders it into. Each pass halves
      # the backslashes, leaving printf '\047' -> a single quote.
      - name: "add-passwd-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "source /bin/passwd_from_secret; source /bin/create_salt_and_sha1; Q=$(printf '\\\\047'); PW=${Q}sha1:${SALT}:${PASSWORD_SHA1}${Q}; for opt in c.PasswordIdentityProvider.hashed_password c.ServerApp.password c.NotebookApp.password; do /bin/add_line_to_configmap ${opt}=${PW} <%= configmap_filename %>; done"
      - name: "add-hostport-to-cfg"
        image: "<%= utility_img %>"
        command:
          - "/bin/bash"
          - "-c"
          - "PORT_CFG=$(kubectl get services $(hostname)-service -o jsonpath='{.spec.ports[0].nodePort}'); HOST_CFG=$(kubectl get pods $(hostname) -o jsonpath='{.spec.nodeName}'); Q=$(printf '\\\\047'); /bin/add_line_to_configmap c.ServerApp.base_url=${Q}/node/${HOST_CFG}/${PORT_CFG}/${Q} <%= configmap_filename %>"